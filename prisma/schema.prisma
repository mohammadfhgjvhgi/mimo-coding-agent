// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id            String   @id @default(cuid())
  title         String   @default("محادثة جديدة")
  model         String   @default("default")
  pinned        Boolean  @default(false)
  folder        String?
  tags          String   @default("[]")
  systemPrompt  String?
  modelSettings String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]
  tasks   Task[]

  @@index([updatedAt])
  @@index([folder])
  @@index([pinned])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  role            String
  content         String
  model           String?
  toolCalls       String?
  parentMessageId String?
  tokens          Int      @default(0)
  thinking        String?
  isEdited        Boolean  @default(false)
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Memory {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  category        String   @default("general")
  source          String   @default("agent")
  tier            String   @default("semantic")
  confidence      Float    @default(0.8)
  decayRate       Float    @default(365)
  accessCount     Int      @default(0)
  lastAccessedAt  DateTime @default(now())
  failureHash     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([tier])
  @@index([failureHash])
}

model Task {
  id                 String   @id @default(cuid())
  conversationId     String?
  goal               String
  acceptanceCriteria String   @default("[]")
  status             String   @default("pending")
  plan               String?
  steps              String   @default("[]")
  currentStep        Int      @default(0)
  agentState         String?  // JSON: conversation messages for resume
  result             String?
  verificationResult String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([updatedAt])
}

model Symbol {
  id        String   @id @default(cuid())
  name      String
  type      String   // function | class | method | variable | import | interface | type
  filePath  String
  line      Int
  column    Int
  endLine   Int
  signature String?
  createdAt DateTime @default(now())

  @@index([name])
  @@index([filePath])
  @@index([type])
}

model ScheduledTask {
  id        String    @id @default(cuid())
  name      String
  schedule  String    // daily | weekly | monthly
  goal      String
  lastRun   DateTime?
  nextRun   DateTime?
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled])
  @@index([nextRun])
}

model SystemState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model KnowledgeChunk {
  id            String   @id @default(cuid())
  collectionId  String?
  source        String
  sourceType    String   @default("text") // text|pdf|docx|md|code|url|note
  content       String
  embedding     String
  chunkIndex    Int
  tokens        Int      @default(0)
  metadata      String?
  createdAt     DateTime @default(now())

  @@index([source])
  @@index([collectionId])
  @@index([sourceType])
}

model KnowledgeCollection {
  id          String   @id @default(cuid())
  name        String
  description String?
  scope       String   @default("personal") // personal|project|shared
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope])
}

model ResearchJob {
  id           String   @id @default(cuid())
  query        String
  status       String   @default("pending")
  depth        String   @default("standard")
  plan         String?
  sources      String   @default("[]")
  findings     String   @default("[]")
  claims       String   @default("[]")
  report       String?
  citations    String?
  tokenUsage   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// MCP OS — Model Context Protocol servers (plug-and-play integration layer).
// Stores discovered tools, capability scopes, permissions, secrets, health, rate limits.
model McpServer {
  id            String   @id @default(cuid())
  name          String   @unique
  // url | stdio | sse
  transport     String   @default("url")
  // For url/sse: the endpoint URL. For stdio: the command.
  endpoint      String
  // JSON: { args?: string[], env?: Record<string,string>, headers?: Record<string,string> }
  config        String   @default("{}")
  // "discovered" | "installed" | "enabled" | "disabled" | "error"
  status        String   @default("discovered")
  // JSON: array of discovered tools: [{ name, description, inputSchema }]
  tools         String   @default("[]")
  // JSON: capability scopes granted: ["read", "write", "network", "shell"]
  scopes        String   @default("[]")
  // JSON: per-tool permission overrides: { toolName: "allow"|"deny"|"ask" }
  permissions   String   @default("{}")
  // JSON: rate-limit policy: { rpm: number, burst: number, lastWindowStart: string, count: number }
  rateLimit     String   @default("{}")
  // Health-check metadata: { lastCheckAt, ok, latencyMs, error? }
  health        String   @default("{}")
  // Reference to secrets (stored separately, never inline): { apiKey: "secret:uuid" }
  secretRefs    String   @default("{}")
  description   String?
  version       String?
  installedAt   DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

// MCP OS — secrets storage. Values are encrypted at the application layer
// using a simple AES-256-GCM cipher with a key derived from MCP_SECRET_KEY env
// (or a per-workspace fallback key).
model McpSecret {
  id        String   @id @default(cuid())
  // Logical name within a server's config: e.g. "apiKey", "dbPassword"
  name      String
  // Cipher text + IV + tag, JSON: { iv, tag, ciphertext }
  value     String
  serverId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serverId])
  @@index([name])
}

// MCP OS — audit log of every tool call (success + failure + permission denial).
// Used for observability, compliance, and post-mortem analysis.
model McpAuditLog {
  id         String   @id @default(cuid())
  serverName String
  toolName   String
  // "call" | "permission_denied" | "rate_limited" | "discovery" | "health" | "install"
  action     String
  // "success" | "error" | "denied" | "skipped"
  status     String
  // Truncated arguments JSON (first 2000 chars)
  args       String   @default("{}")
  // Truncated result JSON (first 2000 chars)
  result     String?
  durationMs Int      @default(0)
  // caller: "agent" | "user" | "system"
  caller     String   @default("agent")
  error      String?
  createdAt  DateTime @default(now())

  @@index([serverName])
  @@index([toolName])
  @@index([status])
  @@index([createdAt])
}

// Plugins — plug-and-play extension system for MiMo X.
// Plugins are JS/TS modules loaded at runtime that can register tools,
// hooks, UI panels, and providers. They are isolated, versioned, and
// permission-gated — inspired by VS Code extensions.
model Plugin {
  id              String   @id @default(cuid())
  // Unique plugin slug: e.g. "com.mimo.calculator"
  name            String   @unique
  // Human-readable display name
  displayName     String
  description     String?
  version         String
  // Semantic version of the manifest schema (for forward-compat)
  manifestVersion String   @default("1.0.0")
  author          String?
  homepage        String?
  repository      String?
  // Filesystem path to the plugin entry (relative to workspace or absolute)
  entryPath       String
  // "module" (ESM/CJS import) | "inline" (code in `inlineSource`)
  entryType       String   @default("module")
  inlineSource    String?
  // JSON: manifest as declared by the plugin (capabilities, permissions, hooks, tools)
  manifest        String   @default("{}")
  // JSON: capabilities granted: ["tools", "hooks", "ui_panels", "providers", "commands"]
  capabilities    String   @default("[]")
  // JSON: permissions granted: ["filesystem:read", "shell:exec", "network:http", "db:rw"]
  permissions     String   @default("[]")
  // JSON: settings schema + current values: { schema: {}, values: {} }
  settings        String   @default("{}")
  // "registered" | "enabled" | "disabled" | "error" | "uninstalled"
  status          String   @default("registered")
  // SHA-256 of the entry file at registration time (for tamper detection)
  checksum        String?
  // JSON: isolation policy: { sandbox: boolean, maxHeapMb: number, timeoutMs: number }
  isolation       String   @default("{}")
  // JSON: version history: [{ version, installedAt, checksum }]
  versionHistory  String   @default("[]")
  // JSON: last activation result: { ok, error?, activatedAt }
  activation      String   @default("{}")
  registeredAt    DateTime @default(now())
  installedAt     DateTime?
  lastActivatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([name])
}

// Plugin Logs — every plugin lifecycle event + tool call goes here.
// Used for debugging, audit, and the plugin dev panel.
model PluginLog {
  id         String   @id @default(cuid())
  pluginName String
  // "register" | "enable" | "disable" | "activate" | "deactivate"
  // | "tool_call" | "hook_run" | "settings_change" | "error" | "install"
  action     String
  // "info" | "warn" | "error" | "debug"
  level      String   @default("info")
  message    String
  // JSON: structured context (toolName, args, durationMs, etc.)
  context    String   @default("{}")
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([pluginName])
  @@index([action])
  @@index([level])
  @@index([createdAt])
}
