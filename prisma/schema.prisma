// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id            String   @id @default(cuid())
  title         String   @default("محادثة جديدة")
  model         String   @default("default")
  pinned        Boolean  @default(false)
  folder        String?
  tags          String   @default("[]")
  systemPrompt  String?
  modelSettings String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]
  tasks   Task[]

  @@index([updatedAt])
  @@index([folder])
  @@index([pinned])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  role            String
  content         String
  model           String?
  toolCalls       String?
  parentMessageId String?
  tokens          Int      @default(0)
  thinking        String?
  isEdited        Boolean  @default(false)
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Memory {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  category        String   @default("general")
  source          String   @default("agent")
  tier            String   @default("semantic")
  confidence      Float    @default(0.8)
  decayRate       Float    @default(365)
  accessCount     Int      @default(0)
  lastAccessedAt  DateTime @default(now())
  failureHash     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([tier])
  @@index([failureHash])
}

model Task {
  id                 String   @id @default(cuid())
  conversationId     String?
  goal               String
  acceptanceCriteria String   @default("[]")
  status             String   @default("pending")
  plan               String?
  steps              String   @default("[]")
  currentStep        Int      @default(0)
  agentState         String?  // JSON: conversation messages for resume
  result             String?
  verificationResult String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([updatedAt])
}

model Symbol {
  id        String   @id @default(cuid())
  name      String
  type      String   // function | class | method | variable | import | interface | type
  filePath  String
  line      Int
  column    Int
  endLine   Int
  signature String?
  createdAt DateTime @default(now())

  @@index([name])
  @@index([filePath])
  @@index([type])
}

model ScheduledTask {
  id        String    @id @default(cuid())
  name      String
  schedule  String    // daily | weekly | monthly
  goal      String
  lastRun   DateTime?
  nextRun   DateTime?
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled])
  @@index([nextRun])
}

model SystemState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  source      String
  content     String
  embedding   String
  chunkIndex  Int
  createdAt   DateTime @default(now())

  @@index([source])
}
