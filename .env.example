# MiMo X — Environment Variables
# Copy this file to .env and adjust as needed.

# Database (SQLite) — relative path works on all OS (Windows/Linux/Mac)
DATABASE_URL=file:../db/custom.db

# Workspace root (optional — defaults to process.cwd())
# MIMO_WORKSPACE_ROOT=C:\Users\your-name\projects\my-project

# Ollama URL (optional — defaults to http://localhost:11434)
# MIMO_OLLAMA_URL=http://localhost:11434

# Next.js URL for Electron (optional — defaults to http://localhost:3000)
# MIMO_NEXT_URL=http://localhost:3000
