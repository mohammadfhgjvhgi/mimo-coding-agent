{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "skills",
    "infrastructure",
    "electron",
    "testproj",
    "src/components/chat/panels/pending",
    "skills/imported",
    "src/lib/ai/embeddings.ts",
    "src/lib/autonomy/triggers.ts",
    "src/lib/knowledge/graph.ts",
    "src/lib/knowledge/ingestion.ts",
    "src/lib/knowledge/retrieval.ts",
    "src/lib/learning/engine.ts",
    "src/lib/evaluation/suite.ts",
    "src/lib/security/policy.ts",
    "src/lib/security/audit.ts",
    "src/lib/memory/consolidation.ts"
  ]
}
